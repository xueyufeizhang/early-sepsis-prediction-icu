# ============================================================================
#  COMPLIANCE — PhysioNet Data Use Agreement
#  MIMIC-IV / MIMIC-III / eICU patient-level data AND any derivatives
#  must NOT be committed, pushed, or sent to third-party services.
#  This .gitignore is the first line of defense. Do not weaken it.
# ============================================================================

# --- Raw / derived patient data (never commit) ---
*.csv
*.parquet
*.feather
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.sqlite
*.db
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# --- Credentials / secrets ---
.env
.env.*
*.pem
service-account*.json
credentials*.json
*-key.json
kaggle.json

# --- Trained model artifacts (can be large; regenerated by pipeline) ---
results/models/*
!results/models/.gitkeep
*.pt
*.pth
*.ckpt
*.joblib
*.onnx
*.tflite

# --- Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.ipynb_checkpoints

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
*.swp
*~

# --- Local-only planning and research material (never publish) ---
/scratch/
/AGENTS.md
/project_brief.md
